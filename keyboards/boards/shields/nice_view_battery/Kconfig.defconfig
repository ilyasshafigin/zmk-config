if SHIELD_NICE_VIEW_BATTERY

config LS0XX_VCOM_THREAD_PRIO
    default 11

config LV_Z_VDB_SIZE
    default 100

config LV_DPI_DEF
    default 161

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

choice ZMK_DISPLAY_WORK_QUEUE
    default ZMK_DISPLAY_WORK_QUEUE_DEDICATED
endchoice

choice ZMK_DISPLAY_STATUS_SCREEN
    default ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
endchoice

config LV_Z_MEM_POOL_SIZE
    default 8192 if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM

config ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    imply NICE_VIEW_BATTERY_WIDGET_STATUS

config NICE_VIEW_BATTERY_WIDGET_STATUS
    bool "Peripheral nice!view battery status widget"
    select LV_USE_LABEL
    select LV_USE_IMAGE
    select LV_USE_CANVAS

config NICE_VIEW_BATTERY_WIDGET_INVERTED
    bool "Invert battery status widget colors"

config NICE_VIEW_BATTERY_PERCENT_ROTATE_180
    bool "Rotate battery percentage 180 degrees in the raw display coordinates"
    default y if SHIELD_TEMPORAL_PERIPHERAL_RIGHT

endif # SHIELD_NICE_VIEW_BATTERY
